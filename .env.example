# ==========================================================
# Srikrishna Seva Niketan — Public Website (Frontend)
# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored and must NEVER be committed.
# ==========================================================

# Upstream backend API that the server-side proxy (/api/public/proxy)
# forwards public requests to. Include the scheme, no trailing slash.
#
# Local backend:
#   VITE_API_UPSTREAM=http://localhost:8000
# Deployed (Render) backend:
#   VITE_API_UPSTREAM=https://srikrishna-seva-niketan-backend.onrender.com
VITE_API_UPSTREAM=http://localhost:8000
