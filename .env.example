# ==========================================================
# Srikrishna Seva Niketan — Public Website (Frontend)
# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored and must NEVER be committed.
# ==========================================================

# Upstream backend API that the server-side proxy (/api/public/proxy)
# forwards public requests to.
# IMPORTANT: this MUST include the /api/v1 prefix (the client sends bare
# resource paths like /services, and the proxy appends them to this value).
#
# Local backend:
#   VITE_API_UPSTREAM=http://localhost:8000/api/v1
# Deployed (Render) backend:
#   VITE_API_UPSTREAM=https://srikrishna-seva-niketan-backend-y3fe.onrender.com/api/v1
VITE_API_UPSTREAM=http://localhost:8000/api/v1
